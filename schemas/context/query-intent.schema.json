{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ueaf.dev/schemas/context/query-intent.schema.json",
  "x-ueaf-schema-version": "1.0.0",
  "title": "QueryIntent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "query_intent_id",
    "task_id",
    "run_id",
    "principal_context_ref",
    "query",
    "purpose",
    "source_constraints",
    "authorization_scope_ref",
    "freshness_requirement",
    "citation_requirement",
    "budget_slice",
    "normalized_query_hash",
    "policy_snapshot_ref",
    "expires_at"
  ],
  "properties": {
    "meta": {"$ref": "https://ueaf.dev/schemas/common/contract-meta.schema.json"},
    "query_intent_id": {"$ref": "#/$defs/nonEmptyString"},
    "task_id": {"$ref": "#/$defs/nonEmptyString"},
    "run_id": {"$ref": "#/$defs/nonEmptyString"},
    "principal_context_ref": {"$ref": "#/$defs/nonEmptyString"},
    "query": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "source_constraints": {"$ref": "#/$defs/sourceConstraints"},
    "authorization_scope_ref": {"$ref": "#/$defs/nonEmptyString"},
    "freshness_requirement": {"$ref": "#/$defs/freshnessRequirement"},
    "citation_requirement": {"$ref": "#/$defs/citationRequirement"},
    "budget_slice": {"$ref": "#/$defs/queryBudget"},
    "normalized_query_hash": {"$ref": "#/$defs/nonEmptyString"},
    "policy_snapshot_ref": {"$ref": "#/$defs/nonEmptyString"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "refList": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "sourceConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_source_refs",
        "denied_source_refs",
        "from_time",
        "to_time",
        "max_age_seconds",
        "regions",
        "languages"
      ],
      "properties": {
        "allowed_source_refs": {"$ref": "#/$defs/refList"},
        "denied_source_refs": {"$ref": "#/$defs/refList"},
        "from_time": {"type": ["string", "null"], "format": "date-time"},
        "to_time": {"type": ["string", "null"], "format": "date-time"},
        "max_age_seconds": {"type": ["integer", "null"], "minimum": 0},
        "regions": {"$ref": "#/$defs/refList"},
        "languages": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"},
          "uniqueItems": true
        }
      }
    },
    "freshnessRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_age_seconds", "required_as_of"],
      "properties": {
        "max_age_seconds": {"type": ["integer", "null"], "minimum": 0},
        "required_as_of": {"type": "string", "format": "date-time"}
      }
    },
    "citationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_level", "minimum_evidence_items", "max_age_seconds"],
      "properties": {
        "item_level": {"type": "boolean"},
        "minimum_evidence_items": {"type": "integer", "minimum": 0},
        "max_age_seconds": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "queryBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_results", "max_latency_ms", "max_source_queries", "max_cost_amount", "currency"],
      "properties": {
        "max_results": {"type": "integer", "minimum": 0},
        "max_latency_ms": {"type": "integer", "minimum": 1},
        "max_source_queries": {"type": "integer", "minimum": 1},
        "max_cost_amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    }
  }
}
