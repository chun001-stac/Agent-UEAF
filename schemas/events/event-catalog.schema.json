{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ueaf.dev/schemas/events/event-catalog.schema.json",
  "x-ueaf-schema-version": "1.0.0",
  "title": "UEAF Event Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "x-ueaf-schema-version", "catalog_version", "events"],
  "properties": {
    "$schema": {"const": "https://ueaf.dev/schemas/events/event-catalog.schema.json"},
    "x-ueaf-schema-version": {"const": "1.0.0"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/eventRegistration"}
    }
  },
  "$defs": {
    "eventRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_name", "event_version", "payload_schema_ref"],
      "properties": {
        "event_name": {"type": "string", "pattern": "^ueaf\\.[a-z0-9_]+\\.[a-z0-9_]+$"},
        "event_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "payload_schema_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
