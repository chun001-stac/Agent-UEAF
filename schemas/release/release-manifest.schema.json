{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ueaf.dev/schemas/release/release-manifest.schema.json",
  "x-ueaf-schema-version": "1.0.0",
  "title": "ReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "release_id", "environment", "lifecycle_status", "agent_versions", "prompt_versions", "schema_versions", "model_route_versions", "capability_versions", "adapter_versions", "knowledge_index_versions", "memory_policy_versions", "policy_versions", "contract_version_ranges", "compatibility_matrix_ref", "migration_refs", "quality_gate_decision_ref", "security_gate_decision_ref", "operational_readiness_decision_ref", "release_decision_ref", "rollout", "rollback", "observation_window", "integrity_ref"],
  "properties": {
    "meta": {"$ref": "https://ueaf.dev/schemas/common/contract-meta.schema.json"},
    "release_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "lifecycle_status": {"type": "string", "enum": ["draft", "under_review", "approved", "rolling_out", "active", "superseded", "rolled_back", "withdrawn"]},
    "agent_versions": {"$ref": "#/$defs/versionRefs"},
    "prompt_versions": {"$ref": "#/$defs/versionRefs"},
    "schema_versions": {"$ref": "#/$defs/versionRefs"},
    "model_route_versions": {"$ref": "#/$defs/versionRefs"},
    "capability_versions": {"$ref": "#/$defs/versionRefs"},
    "adapter_versions": {"$ref": "#/$defs/versionRefs"},
    "knowledge_index_versions": {"$ref": "#/$defs/versionRefs"},
    "memory_policy_versions": {"$ref": "#/$defs/versionRefs"},
    "policy_versions": {"$ref": "#/$defs/versionRefs"},
    "contract_version_ranges": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "compatibility_matrix_ref": {"type": "string", "minLength": 1},
    "migration_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "quality_gate_decision_ref": {"type": "string", "minLength": 1},
    "security_gate_decision_ref": {"type": "string", "minLength": 1},
    "operational_readiness_decision_ref": {"type": "string", "minLength": 1},
    "release_decision_ref": {"type": "string", "minLength": 1},
    "rollout": {"$ref": "#/$defs/rolloutPlan"},
    "rollback": {"$ref": "#/$defs/rollbackPlan"},
    "observation_window": {"$ref": "#/$defs/observationWindow"},
    "integrity_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "versionRefs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "refList": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "nonEmptyRefList": {"$ref": "#/$defs/refList", "minItems": 1},
    "rolloutPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_refs", "stop_condition_refs", "capacity_limit_ref"],
      "properties": {
        "slice_refs": {"$ref": "#/$defs/nonEmptyRefList"},
        "stop_condition_refs": {"$ref": "#/$defs/nonEmptyRefList"},
        "capacity_limit_ref": {"type": "string", "minLength": 1}
      }
    },
    "rollbackPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_release_ref", "irreversible_migration_refs", "recovery_precondition_refs"],
      "properties": {
        "target_release_ref": {"type": "string", "minLength": 1},
        "irreversible_migration_refs": {"$ref": "#/$defs/refList"},
        "recovery_precondition_refs": {"$ref": "#/$defs/refList"}
      }
    },
    "observationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "success_condition_refs", "failure_condition_refs"],
      "properties": {
        "duration_seconds": {"type": "integer", "minimum": 1},
        "success_condition_refs": {"$ref": "#/$defs/nonEmptyRefList"},
        "failure_condition_refs": {"$ref": "#/$defs/nonEmptyRefList"}
      }
    }
  }
}
