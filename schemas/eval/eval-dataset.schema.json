{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ueaf.dev/schemas/eval/eval-dataset.schema.json",
  "x-ueaf-schema-version": "1.0.0",
  "title": "EvalDataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "eval_dataset_id", "dataset_version", "case_refs", "slices", "holdout_case_refs", "exposure_metadata_ref", "contamination_metadata_ref", "access_policy_ref", "deletion_propagation_ref", "content_digest", "integrity_ref"],
  "properties": {
    "meta": {"$ref": "https://ueaf.dev/schemas/common/contract-meta.schema.json"},
    "eval_dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "case_refs": {"$ref": "#/$defs/nonEmptyRefList"},
    "slices": {"type": "array", "items": {"$ref": "#/$defs/datasetSlice"}, "minItems": 1},
    "holdout_case_refs": {"$ref": "#/$defs/refList"},
    "exposure_metadata_ref": {"type": "string", "minLength": 1},
    "contamination_metadata_ref": {"type": "string", "minLength": 1},
    "access_policy_ref": {"type": "string", "minLength": 1},
    "deletion_propagation_ref": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "minLength": 1},
    "integrity_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "refList": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "nonEmptyRefList": {"$ref": "#/$defs/refList", "minItems": 1},
    "datasetSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_id", "case_refs", "sampling_weight"],
      "properties": {
        "slice_id": {"type": "string", "minLength": 1},
        "case_refs": {"$ref": "#/$defs/nonEmptyRefList"},
        "sampling_weight": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
