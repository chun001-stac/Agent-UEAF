{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ueaf.dev/schemas/profiles/subject-profile.schema.json",
  "title": "SubjectProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "subject_type", "schema_version", "mutable_fields", "replace_only_fields", "bounded_fields", "conditional_fields", "frozen_fields", "cross_field_constraints", "mutation_limits"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "subject_type": {"type": "string", "enum": ["agent", "skill", "tool", "workflow", "strategy"]},
    "schema_version": {"type": "string", "minLength": 1},
    "mutable_fields": {"type": "array", "items": {"$ref": "#/$defs/fieldRule"}},
    "replace_only_fields": {"type": "array", "items": {"$ref": "#/$defs/fieldRule"}},
    "bounded_fields": {"type": "array", "items": {"$ref": "#/$defs/fieldRule"}},
    "conditional_fields": {"type": "array", "items": {"$ref": "#/$defs/fieldRule"}},
    "frozen_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "cross_field_constraints": {"type": "array", "items": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/constraintRule"}]}},
    "mutation_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_fields_per_candidate", "max_components_per_candidate", "max_scopes_per_candidate", "allow_mixed_repair_levels", "require_single_hypothesis"],
      "properties": {
        "max_fields_per_candidate": {"type": "integer", "minimum": 1},
        "max_components_per_candidate": {"type": "integer", "minimum": 1},
        "max_scopes_per_candidate": {"type": "integer", "minimum": 1},
        "allow_mixed_repair_levels": {"type": "boolean"},
        "require_single_hypothesis": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "fieldRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "operations", "required_repair_levels", "risk_class"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["number", "integer", "string", "boolean", "ref", "array", "object"]},
        "operations": {"type": "array", "items": {"type": "string", "enum": ["replace", "add", "remove"]}, "minItems": 1, "uniqueItems": true},
        "required_repair_levels": {"type": "array", "items": {"type": "string", "enum": ["r1", "r2", "r3", "r4"]}, "minItems": 1, "uniqueItems": true},
        "risk_class": {"type": "string", "minLength": 1},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "enum_values": {"type": "array", "minItems": 1, "uniqueItems": true},
        "pattern": {"type": "string"},
        "allowed_registry": {"type": "string"},
        "compatibility_profile_ref": {"type": "string"},
        "min_items": {"type": "integer", "minimum": 0},
        "max_items": {"type": "integer", "minimum": 0},
        "requires_canary": {"type": "boolean"},
        "requires_human_review": {"type": "boolean"}
      }
    },
    "constraintRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "rule"],
      "properties": {
        "constraint_id": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1},
        "message": {"type": "string"}
      }
    }
  }
}
