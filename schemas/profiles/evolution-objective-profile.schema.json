{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ueaf.dev/schemas/profiles/evolution-objective-profile.schema.json",
  "title": "EvolutionObjectiveProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective_profile_id", "primary_objectives", "hard_constraints", "guardrails", "business_metric_mapping", "selection"],
  "properties": {
    "objective_profile_id": {"type": "string", "minLength": 1},
    "primary_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "direction", "weight"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "direction": {"type": "string", "enum": ["maximize", "minimize"]},
          "weight": {"type": "number", "minimum": 0},
          "minimum_improvement": {"type": "number"}
        }
      }
    },
    "hard_constraints": {"type": "object", "minProperties": 1, "additionalProperties": true},
    "guardrails": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max_regression_pct": {"type": "number", "minimum": 0},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"}
        }
      }
    },
    "business_metric_mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "ref"],
        "properties": {
          "source": {"type": "string", "enum": ["eval_slice", "production_metric", "business_system", "manual_review"]},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "min_evidence_confidence", "tie_breakers"],
      "properties": {
        "method": {"type": "string", "enum": ["constrained_weighted_delta", "lexicographic", "policy_defined"]},
        "min_evidence_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "tie_breakers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
