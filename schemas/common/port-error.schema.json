{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ueaf.dev/schemas/common/port-error.schema.json",
  "x-ueaf-schema-version": "1.0.0",
  "title": "PortError",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "category", "retryability", "certainty", "message_ref", "provider_error_ref", "observed_at", "details_schema_ref"],
  "properties": {
    "code": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "retryability": {"type": "string", "enum": ["never", "safe", "conditional", "after_reconciliation"]},
    "certainty": {"type": "string", "enum": ["not_executed", "unknown"]},
    "message_ref": {"type": ["string", "null"], "minLength": 1},
    "provider_error_ref": {"type": ["string", "null"], "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "details_schema_ref": {"type": ["string", "null"], "minLength": 1}
  }
}
